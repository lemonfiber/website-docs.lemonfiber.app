{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"],

    // Also set by the preset. Stated here because SonarQube Cloud reads this file
    // without node_modules, so it cannot see the preset, and it judges an
    // optional field typed `| undefined` by whether this is on.
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    "checkJs": false,
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "src/paraglide", "vendor"]
}
