      "repo": "plugin-template",
      "path": "docs/development.md",
      "remote": "https://github.com/lemonfiber/plugin-template",
      "branch": "main",
      "label": "lemonfiber/plugin-template",
      "title": "Writing a plugin from the template"
    },
    {
      "route": "plugins/the-catalogue.md",
      "repo": "lemonfiber-plugins",
      "path": "README.md",
