    {
      "route": "commands/every-command.md",
      "repo": "lemonfiber",
      "path": "reference/commands.md",
      "remote": "https://github.com/lemonfiber/lemonfiber",
      "branch": "main",
      "label": "lemonfiber/lemonfiber"
    },
    {
      "route": "commands/reference",
      "repo": "lemonfiber",
      "path": "reference/commands",
      "remote": "https://github.com/lemonfiber/lemonfiber",
