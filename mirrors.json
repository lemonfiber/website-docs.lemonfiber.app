{
  "$comment": "Every tree this site renders but does not own. Each route under src/content/docs is a symlink into vendor/<repo>/<path>, and vendor/ is submodules pinned to exact revisions. Nothing here is fetched at build time.",
  "mirrors": [
    {
      "route": "spec",
      "repo": "spec",
      "path": "",
      "remote": "https://github.com/lemonfiber/spec",
      "branch": "main",
      "label": "lemonfiber/spec",
      "include": [
        "00-overview",
        "10-functional",
        "20-architecture",
        "30-repos",
        "40-quality",
        "50-governance",
        "60-brand",
        "70-operations",
        "90-appendix"
      ]
    },
    {
      "route": "develop/architecture",
      "repo": "lemonfiber",
      "path": ".docs/architecture",
      "remote": "https://github.com/lemonfiber/lemonfiber",
      "branch": "main",
      "label": "lemonfiber/lemonfiber",
      "index": "00-index"
    },
    {
      "route": "develop/brand",
      "repo": "brand",
      "path": ".docs",
      "remote": "https://github.com/lemonfiber/brand",
      "branch": "main",
      "label": "lemonfiber/brand"
    },
    {
