{
  "name": "@lemonfiber/website-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The lemonfiber documentation site: a renderer over the repos' own docs, for users, developers and powerusers.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonfiber/website-docs.lemonfiber.app.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "sync": "astro sync",
    "types": "astro check --minimumFailingSeverity hint",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard": "node scripts/guards.ts",
    "arch": "depcruise src scripts astro.config.ts --config .dependency-cruiser.cjs",
    "links": "node scripts/links.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "ci": "npm run messages && npm run sync && npm run format:check && npm run lint && npm run types && npm run guard && npm run arch && npm run coverage && npm run build && npm run links && npm run a11y",
    "a11y": "node scripts/a11y.ts",
    "browser": "playwright install --with-deps chromium",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@lemonfiber/brand": "github:lemonfiber/brand#bf744887777e6da21f4c8a641dd553c8b32099e4",
    "@lemonfiber/website-kit": "github:lemonfiber/website-kit#abaf7cac70901cb976fee79c29a9a55cc9243e3b"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/starlight": "^0.42.9",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.0",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "^7.4.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "smol-toml": "^1.9.1",
    "starlight-links-validator": "^0.27.0",
    "starlight-sidebar-topics": "^0.9.0",
    "starlight-versions": "^0.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    },
    "minimatch": "^11.0.3"
  }
}
