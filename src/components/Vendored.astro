---
import { Code } from "@astrojs/starlight/components";

import { serviceBlock } from "../lib/compose";
import { present } from "../lib/release";
import { vendored } from "../lib/schema-source";
import * as m from "../paraglide/messages.js";
import Absent from "./Absent.astro";

interface Props {
  /** The pinned tree, as it is named under `vendor/`. */
  readonly repo: string;
  /** The file within it. */
  readonly path: string;
  /** What Expressive Code highlights it as. */
  readonly lang: string;
  /** In a Compose file, the one service to show rather than the whole file. */
  readonly service?: string;
}

/** One file of a pinned tree, or one service out of a Compose file, as the revision this site pins has it. */
const { repo, path, lang, service } = Astro.props;
const read = vendored(`${repo}/${path}`);
const text = present(
  read === "" ? null : read,
  `vendor/${repo}/${path} is not in the checkout`,
);
const shown = present(
  text === null || service === undefined ? text : serviceBlock(text, service),
  `vendor/${repo}/${path} declares no service ${service ?? ""}`,
);
---

{shown === null ? (
  <Absent />
) : (
  <Code code={shown} lang={lang} title={m.vendored_from({ path, repo })} />
)}
