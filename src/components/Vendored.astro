---
import { Code } from "@astrojs/starlight/components";

import { present } from "../lib/release";
import { vendored } from "../lib/schema-source";
import * as m from "../paraglide/messages.js";
import Absent from "./Absent.astro";

interface Props {
  /** The pinned tree, as it is named under `vendor/`. */
  readonly repo: string;
  /** The file within it. */
  readonly path: string;
  /** What Expressive Code highlights it as. */
  readonly lang: string;
}

/** One file of a pinned tree, as the revision this site pins has it. */
const { repo, path, lang } = Astro.props;
const read = vendored(`${repo}/${path}`);
const shown = present(
  read === "" ? null : read,
  `vendor/${repo}/${path} is not in the checkout`,
);
---

{shown === null ? (
  <Absent />
) : (
  <Code code={shown} lang={lang} title={m.vendored_from({ path, repo })} />
)}
