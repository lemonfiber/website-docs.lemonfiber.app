---
import manifest from "../../mirrors.json";
import { dayOf, shortSha, type Mirror } from "@lemonfiber/website-kit/mirror";
import { revisionAt } from "../lib/checkout";
import * as m from "../paraglide/messages.js";

/** The repository the API reference is read out of. */
const CORE = "lemonfiber";

const mirrors = manifest.mirrors as readonly Mirror[];
const label = mirrors.find((mirror) => mirror.repo === CORE)?.label ?? CORE;

// The checkout is the working directory: Astro runs its build from the project
// root, and a module's own location is rewritten by the bundler.
const revision = revisionAt(`vendor/${CORE}`);
const stamp =
  revision === null
    ? null
    : m.pinned_at({
        repo: label,
        revision: shortSha(revision.sha),
        date: dayOf(revision.date),
      });
---

{stamp !== null && (
  <p class="pinned">
    <strong>{m.pinned_lead()}</strong>
    <span>{stamp}</span>
  </p>
)}

<style>
  .pinned {
    margin-top: var(--sp-5);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-stamp);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }
</style>
