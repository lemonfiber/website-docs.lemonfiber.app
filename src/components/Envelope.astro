---
import { envelopeOf } from "../lib/envelope";
import { contract } from "../lib/schema-source";
import * as m from "../paraglide/messages.js";
import Prose from "./Prose.astro";
import Type from "./Type.astro";

/** The envelope's fields, as every kind in the pinned contract declares them. */
const fields = envelopeOf(contract());
if (fields.length === 0)
  throw new Error("contract/web-api/ declares no envelope to render");
import Region from "./Region.astro";
---

<Region label={m.table_envelope()}>
  <table>
    <thead>
      <tr>
        <th>{m.ref_field()}</th>
        <th>{m.ref_type()}</th>
        <th>{m.ref_required()}</th>
        <th>{m.ref_meaning()}</th>
      </tr>
    </thead>
    <tbody>
      {fields.map((field) => (
        <tr>
          <td>
            <code>{field.name}</code>
          </td>
          <td>
            {field.type === null ? (
              <Prose text={m.envelope_by_kind()} />
            ) : (
              <Type tokens={field.type} prefix="type-" />
            )}
          </td>
          <td>{field.required ? m.ref_yes() : m.ref_no()}</td>
          <td>
            <Prose text={field.description} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Region>
