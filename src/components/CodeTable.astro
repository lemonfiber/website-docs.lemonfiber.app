---
import { anchorOf, codesIn } from "../lib/registry";
import { registry } from "../lib/schema-source";
import * as m from "../paraglide/messages.js";
import Region from "./Region.astro";
import Runs from "./Runs.astro";

interface Props {
  /** The family whose codes to set out: `PLUGIN`. */
  readonly family: string;
}

/** Every code in one family, read from the registry the pinned core publishes. */
const { family } = Astro.props;
const read = registry();
if (read === null)
  throw new Error("contract/codes.json is missing or unreadable");
const codes = codesIn(read, family);
if (codes.length === 0)
  throw new Error(`contract/codes.json declares no code in ${family}`);
---

<Region label={m.codes_table({ family })}>
  <table class="lf-cards codes">
    <thead>
      <tr>
        <th>{m.codes_code()}</th>
        <th>{m.codes_severity()}</th>
        <th>{m.codes_exit()}</th>
        <th>{m.codes_meaning()}</th>
        <th>{m.codes_remedy()}</th>
      </tr>
    </thead>
    <tbody>
      {codes.map((code) => (
        <tr id={anchorOf(code.code)}>
          <th scope="row">
            <a href={`#${anchorOf(code.code)}`}>
              <code>{code.code}</code>
            </a>
          </th>
          <td data-label={m.codes_severity()}>
            <span class={`severity severity--${code.severity}`}>
              {code.severity}
            </span>
          </td>
          <td data-label={m.codes_exit()}>
            <code>{code.exit}</code>
          </td>
          <td data-label={m.codes_meaning()}>
            <Runs text={code.meaning} />
          </td>
          <td data-label={m.codes_remedy()}>
            <Runs text={code.remedy} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Region>

<style>
  /* Severity reads by its word; the critical and warning words carry weight so
     the worst rows stand out when scanning, with no colour carrying meaning
     alone. */
  .severity {
    white-space: nowrap;
  }
  .severity--critical {
    font-weight: 700;
    color: var(--text);
  }
  .severity--warning {
    font-weight: 600;
  }
  .codes th[scope="row"] a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    text-decoration: none;
  }
  .codes th[scope="row"] {
    white-space: nowrap;
  }
  /* On a narrow screen a row is a card: the code heads it, and severity and
     exit share a line under it. */
  @media (max-width: 50rem) {
    .codes tr {
      display: grid;
      grid-template-columns: auto auto 1fr;
      column-gap: var(--sp-4);
    }
    .codes :is(td, th) {
      grid-column: 1 / -1;
    }
    .codes td[data-label]:is(:nth-child(2), :nth-child(3)) {
      grid-column: auto;
    }
  }
</style>
