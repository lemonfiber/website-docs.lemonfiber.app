---
import { codesWhere, type Severity } from "../lib/registry";
import { present } from "../lib/release";
import { registry } from "../lib/schema-source";
import * as m from "../paraglide/messages.js";
import Absent from "./Absent.astro";

interface Props {
  readonly severity?: Severity;
  readonly exit?: number;
}

/** The codes of one severity, or with one exit, as a list in a sentence. */
const { severity, exit } = Astro.props;
const read = present(
  registry(),
  "contract/codes.json is missing or unreadable",
);
const found =
  read === null
    ? []
    : codesWhere(read, {
        ...(severity === undefined ? {} : { severity }),
        ...(exit === undefined ? {} : { exit }),
      }).map((one) => one.code);
const codes = present(
  read === null || found.length > 0 ? found : null,
  "contract/codes.json declares no code of that kind",
);
const last = codes?.at(-1);
const rest = codes?.slice(0, -1) ?? [];
---

{read === null || codes === null ? (
  <Absent inline />
) : (
  <>
    {rest.map((code, at) => (
      <>
        <code>{code}</code>
        {at < rest.length - 1 ? ", " : ` ${m.list_and()} `}
      </>
    ))}
    <code>{last}</code>
  </>
)}
