---
import * as m from "../paraglide/messages.js";

interface Props {
  readonly maturity: string;
}

const LABEL: Record<string, () => string> = {
  shipped: m.maturity_shipped,
  built: m.maturity_built,
  building: m.maturity_building,
  planned: m.maturity_planned,
  withdrawn: m.maturity_withdrawn,
};

const { maturity } = Astro.props;
// A maturity with no label of its own is drawn as the word the catalogue used.
// It read `planned` before, which is the most wrong of the five answers: every
// feature whose every requirement was met and merged appeared as not started,
// on the page whose whole subject is how far each has got. An untranslated word
// is a reader noticing something; a confident wrong one is nobody noticing.
const label = LABEL[maturity]?.() ?? maturity;
---

<span class:list={["mpill", `mpill--${maturity}`]}>{label}</span>

<style>
  /* The mark is a shape as well as a word: a reader who cannot separate the
     accents still sees five different pills. */
  .mpill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    flex: none;
    font-size: var(--lf-size-eyebrow);
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.15em 0.6em;
    border-radius: var(--lf-radius-pill);
    border: 1px solid var(--line);
    color: var(--muted);
    white-space: nowrap;
  }
  .mpill::before {
    content: "";
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    border: 2px solid currentColor;
  }
  .mpill--shipped {
    color: var(--text);
    border-color: var(--text);
  }
  .mpill--shipped::before {
    background: currentColor;
  }
  /* Finished, and waiting on a version to carry it — so the weight of `shipped`
     with a dot that is not yet filled to its edge. */
  .mpill--built {
    color: var(--text);
  }
  .mpill--built::before {
    background: radial-gradient(currentColor 0 45%, transparent 45% 100%);
  }
  .mpill--building {
    color: var(--fiber-deep);
    border-color: var(--fiber-deep);
  }
  .mpill--building::before {
    background: linear-gradient(
      to right,
      currentColor 0 50%,
      transparent 50% 100%
    );
  }
  .mpill--withdrawn {
    text-decoration: line-through;
  }
  .mpill--withdrawn::before {
    border-style: dashed;
  }
</style>
