---
import * as m from "../paraglide/messages.js";

interface Props {
  readonly maturity: string;
}

const LABEL: Record<string, () => string> = {
  shipped: m.maturity_shipped,
  building: m.maturity_building,
  planned: m.maturity_planned,
  withdrawn: m.maturity_withdrawn,
};

const { maturity } = Astro.props;
const label = (LABEL[maturity] ?? m.maturity_planned)();
---

<span class:list={["mpill", `mpill--${maturity}`]}>{label}</span>

<style>
  /* The mark is a shape as well as a word: a reader who cannot separate the
     accents still sees four different pills. */
  .mpill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    flex: none;
    font-size: var(--lf-size-eyebrow);
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.15em 0.6em;
    border-radius: var(--lf-radius-pill);
    border: 1px solid var(--line);
    color: var(--muted);
    white-space: nowrap;
  }
  .mpill::before {
    content: "";
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    border: 2px solid currentColor;
  }
  .mpill--shipped {
    color: var(--text);
    border-color: var(--text);
  }
  .mpill--shipped::before {
    background: currentColor;
  }
  .mpill--building {
    color: var(--fiber-deep);
    border-color: var(--fiber-deep);
  }
  .mpill--building::before {
    background: linear-gradient(
      to right,
      currentColor 0 50%,
      transparent 50% 100%
    );
  }
  .mpill--withdrawn {
    text-decoration: line-through;
  }
  .mpill--withdrawn::before {
    border-style: dashed;
  }
</style>
