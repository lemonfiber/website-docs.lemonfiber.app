---
import { artefact } from "../lib/schema-source";
import { payloads } from "../lib/schema";
import * as m from "../paraglide/messages.js";
import Definitions from "./Definitions.astro";
import Type from "./Type.astro";

/**
 * Every payload kind the pinned binary serves, and every type they are built
 * from, read out of `contract/web-api.contract.json`.
 */
const PREFIX = "type-";
const read = payloads(artefact("web-api.contract.json"));

// A type two kinds define differently has no single shape to publish.
if (read.disagreeing.length > 0)
  throw new Error(
    `web-api.contract.json defines these more than one way: ${read.disagreeing.join(", ")}`,
  );
---

<h2 id="every-kind">{m.ref_kinds_heading()}</h2>
<table>
  <thead>
    <tr>
      <th>{m.ref_kind()}</th>
      <th>{m.ref_payload()}</th>
    </tr>
  </thead>
  <tbody>
    {read.kinds.map((kind) => (
      <tr id={`kind-${kind.name}`}>
        <td>
          <code>{kind.name}</code>
        </td>
        <td>
          <Type tokens={kind.data} prefix={PREFIX} />
        </td>
      </tr>
    ))}
  </tbody>
</table>

<h2 id="every-type">{m.ref_types_heading()}</h2>
<Definitions definitions={read.definitions} prefix={PREFIX} />
