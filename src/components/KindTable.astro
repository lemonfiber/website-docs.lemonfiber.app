---
import { kindSummaries } from "../lib/kinds";
import { contract } from "../lib/schema-source";
import { payloads } from "../lib/schema";
import * as m from "../paraglide/messages.js";
import Prose from "./Prose.astro";

/** Every payload kind the pinned contract describes, each with what its `data` says it is. */
const kinds = kindSummaries(payloads(contract()));
if (kinds.length === 0)
  throw new Error("contract/web-api/ describes no payload kind");
---

<table>
  <thead>
    <tr>
      <th>{m.ref_kind()}</th>
      <th>{m.kinds_summary()}</th>
    </tr>
  </thead>
  <tbody>
    {kinds.map((kind) => (
      <tr>
        <td>
          <code>{kind.name}</code>
        </td>
        <td>{kind.summary !== "" && <Prose text={kind.summary} />}</td>
      </tr>
    ))}
  </tbody>
</table>
