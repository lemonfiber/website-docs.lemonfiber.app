---
import { codesIn, familyAnchor } from "../lib/registry";
import { linkOf } from "../lib/codes";
import { present } from "../lib/release";
import { registry } from "../lib/schema-source";
import * as m from "../paraglide/messages.js";
import Absent from "./Absent.astro";
import Region from "./Region.astro";

/** Every family the pinned core's registry declares, each linked to its page. */
const registered = registry();
const read = present(
  registered === null || registered.families.length === 0 ? null : registered,
  "contract/codes.json declares no family",
);
const capital = (text: string): string =>
  text.charAt(0).toUpperCase() + text.slice(1);
---

{read === null ? (
  <Absent />
) : (
  <Region labelledby="the-families">
    <table>
      <thead>
        <tr>
          <th>{m.codes_family()}</th>
          <th>{m.codes_covers()}</th>
          <th>{m.codes_count()}</th>
        </tr>
      </thead>
      <tbody>
        {read.families.map((family) => (
          <tr id={familyAnchor(family)}>
            <td>
              <a href={linkOf(family.prefix)}>
                <code>{family.prefix}</code>
              </a>
            </td>
            <td>{capital(family.covers)}</td>
            <td>{codesIn(read, family.prefix).length}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Region>
)}
