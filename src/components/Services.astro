---
import { stack } from "../lib/schema-source";
import { servicesOf } from "../lib/stack";
import * as m from "../paraglide/messages.js";

/** Every service the pinned stack declares: what it does, and what its absence costs. */
const services = servicesOf(stack());
if (services.length === 0)
  throw new Error("the pinned stack declares no service to render");
---

<table>
  <thead>
    <tr>
      <th>{m.services_service()}</th>
      <th>{m.services_does()}</th>
      <th>{m.services_without()}</th>
      <th>{m.services_smallest()}</th>
    </tr>
  </thead>
  <tbody>
    {services.map((service) => (
      <tr>
        <td>{service.name}</td>
        <td>{service.describes}</td>
        <td>{service.withoutIt}</td>
        <td>
          {service.smallestForm !== null && <code>{service.smallestForm}</code>}
        </td>
      </tr>
    ))}
  </tbody>
</table>
