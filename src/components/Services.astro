---
import { stack } from "../lib/schema-source";
import { servicesOf } from "../lib/stack";
import * as m from "../paraglide/messages.js";
import Region from "./Region.astro";
import { present } from "../lib/release";
import Absent from "./Absent.astro";

/** Every service the pinned stack declares: what it does, and what its absence costs. */
const services = servicesOf(stack());
const shown = present(
  services.length > 0 ? services : null,
  "the pinned stack declares no service to render",
);
---

{shown === null ? (
  <Absent />
) : (
  <Region label={m.table_services()}>
    <table>
      <thead>
        <tr>
          <th>{m.services_service()}</th>
          <th>{m.services_does()}</th>
          <th>{m.services_without()}</th>
          <th>{m.services_smallest()}</th>
        </tr>
      </thead>
      <tbody>
        {services.map((service) => (
          <tr>
            <td>{service.name}</td>
            <td>{service.describes}</td>
            <td>{service.withoutIt}</td>
            <td>
              {service.smallestForm !== null && (
                <code>{service.smallestForm}</code>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </Region>
)}
